# Copier ce fichier en .env (local) et configurer les mêmes variables
# dans Netlify (Site settings > Environment variables) pour la prod.
# Aucune de ces valeurs ne doit jamais être exposée côté navigateur :
# elles ne sont lues que par les fonctions serverless (netlify/functions).

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=

# --- Google OAuth 2.0 (scope drive.file uniquement) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publique de l'appli (utilisée pour construire l'URL de redirection OAuth)
# ex: https://mon-app.netlify.app
APP_BASE_URL=http://localhost:8888

# --- Session ---
# Clé secrète utilisée pour chiffrer le cookie de session (refresh token Google).
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Supabase (cache partagé des signatures fournisseurs + compteur d'usage IA) ---
# Clé service_role (jamais la clé anon) : voir supabase/migrations/ pour le schéma à créer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Plafond IA & limitation de débit (valeurs par défaut raisonnables, à ajuster si besoin) ---
# Plafond de dépense IA mensuel partagé par tous les utilisateurs, en dollars.
PLAFOND_MENSUEL_USD=5
# Nombre max de scans par utilisateur sur la fenêtre ci-dessous.
LIMITE_SCANS_PAR_FENETRE=15
FENETRE_LIMITE_SCANS_SECONDES=60
# Active des logs détaillés (contenu de facture) pour déboguer l'apprentissage
# de signature. À laisser vide/absent en temps normal.
DEBUG_SIGNATURES=
